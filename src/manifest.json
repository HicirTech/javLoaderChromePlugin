{
  "manifest_version": 3,
  "name": "Jav Links Collector",
  "version": "2.0.0",
  "description": "Collects magnet links from javdb video pages and submits them to an aria2 daemon.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://javdb.com/v/*", "http://192.168.10.102:6800/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jav Links Collector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://javdb.com/v/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
